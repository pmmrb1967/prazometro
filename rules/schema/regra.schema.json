{
  "$id": "https://app.prazometro.workers.dev/rules/schema/regra.schema.json",
  "title": "Regra do Prazómetro",
  "description": "Gerado a partir de packages/engine/src/rules/schema.ts. Não editar à mão.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$"
    },
    "modulo": {
      "type": "string",
      "enum": [
        "garantia",
        "sns",
        "cartas",
        "pos-obito"
      ]
    },
    "titulo": {
      "type": "string",
      "minLength": 1
    },
    "descricao": {
      "type": "string",
      "minLength": 1
    },
    "inicio": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "condicoes": {
      "$ref": "#/$defs/__schema0"
    },
    "prazo": {
      "type": "object",
      "properties": {
        "quantidade": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "unidade": {
          "type": "string",
          "enum": [
            "dias",
            "meses",
            "anos"
          ]
        },
        "contagem": {
          "type": "string",
          "enum": [
            "corridos",
            "uteis"
          ]
        },
        "transita_dia_util": {
          "type": "boolean"
        },
        "transicao": {
          "type": "string",
          "enum": [
            "domingo_feriado",
            "sabado_domingo_feriado"
          ]
        },
        "alertas_dias_antes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 365
          }
        }
      },
      "required": [
        "quantidade",
        "unidade",
        "contagem",
        "transita_dia_util"
      ],
      "additionalProperties": false
    },
    "marcos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "quantidade": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "unidade": {
            "type": "string",
            "enum": [
              "dias",
              "meses",
              "anos"
            ]
          },
          "alerta_dias_antes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 365
          },
          "texto": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "quantidade",
          "unidade",
          "texto"
        ],
        "additionalProperties": false
      }
    },
    "fontes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "titulo": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "artigo": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "titulo",
          "url",
          "artigo"
        ],
        "additionalProperties": false
      }
    },
    "modelos_carta": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verificado_em": {
      "type": "string",
      "format": "date"
    },
    "verificado_por": {
      "type": "string",
      "minLength": 1
    },
    "estado": {
      "type": "string",
      "enum": [
        "publicada",
        "a_rever"
      ]
    },
    "notas": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "modulo",
    "titulo",
    "descricao",
    "inicio",
    "condicoes",
    "prazo",
    "fontes",
    "modelos_carta",
    "verificado_em",
    "verificado_por",
    "estado"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "qualquer": {
          "minItems": 2,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          {
            "type": "object",
            "properties": {
              "igual": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "diferente": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "em": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              },
              "nao_em": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              },
              "min": {
                "type": [
                  "number",
                  "string"
                ]
              },
              "max": {
                "type": [
                  "number",
                  "string"
                ]
              },
              "existe": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  }
}
