{
  "name": "prazometro",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "workers/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @prazometro/web",
    "build": "npm run build -w @prazometro/web",
    "test": "vitest run",
    "test:engine": "vitest run --project engine",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -p packages/engine && tsc -p packages/engine/tsconfig.test.json && tsc -p packages/ai && tsc -p workers/api && tsc -p workers/api/tsconfig.test.json && tsc -p workers/monitor && tsc -p workers/monitor/tsconfig.test.json && tsc -p apps/web",
    "validate:rules": "tsx scripts/validate-rules.ts",
    "schema:rules": "tsx scripts/export-rule-schema.ts",
    "deploy": "npm run build && wrangler deploy -c workers/api/wrangler.jsonc"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
