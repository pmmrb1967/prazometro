{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "app",
  "account_id": "784223b8debec085e40f1ad6cc2b29e9",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // A PWA é servida como ficheiros estáticos (não conta para o limite de pedidos do Worker).
  // Só /api/* corre o código do Worker.
  "assets": {
    "directory": "../../apps/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // Workers AI: a IA gratuita das cartas (neurons gratuitos por dia, sem cartão).
  "ai": { "binding": "AI" },
  // IA gratuita: no máximo 10 leituras por minuto por endereço IP (workers/api/src/ai-free.ts).
  // Contadas em memória pela Cloudflare, também no plano gratuito; o IP nunca se guarda.
  "ratelimits": [
    { "name": "AI_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prazometro",
      "database_id": "d0ed1838-6aa6-4b6d-92b8-d2247e629aa2",
      "migrations_dir": "../../db/migrations",
    },
  ],
}
