{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "monitor",
  "account_id": "784223b8debec085e40f1ad6cc2b29e9",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Sem endereço público: só corre de hora a hora (ao minuto 5, para as estatísticas assentarem).
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["5 * * * *"] },
  "vars": {
    "ACCOUNT_ID": "784223b8debec085e40f1ad6cc2b29e9",
    "DATABASE_ID": "d0ed1838-6aa6-4b6d-92b8-d2247e629aa2",
  },
  // Segredos (wrangler secret put -c workers/monitor/wrangler.jsonc):
  // CF_ANALYTICS_TOKEN (token só com "Account Analytics: Read").
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prazometro",
      "database_id": "d0ed1838-6aa6-4b6d-92b8-d2247e629aa2",
      "migrations_dir": "../../db/migrations",
    },
  ],
}
